{
  "expo": {
    "name": "Escape Challenge",
    "slug": "get-out-of-punishment",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "locales": {
      "en": "./locales/en.json",
      "he": "./locales/he.json"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3498DB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.latzet.meonesh",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["en", "he"],
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Escape Challenge uses the camera so you can take a photo as proof when completing a task.",
        "NSPhotoLibraryUsageDescription": "Escape Challenge needs access to your photo library so you can attach a photo as proof when completing a task.",
        "NSPhotoLibraryAddUsageDescription": "Escape Challenge saves photos you select to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.latzet.meonesh",
      "supportsRtl": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#3498DB",
      "androidMode": "default",
      "androidCollapsedTitle": "Escape Challenge"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3498DB"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escape Challenge needs access to your photo library so you can attach a photo as proof when completing a task.",
          "cameraPermission": "Escape Challenge uses the camera so you can take a photo as proof when completing a task.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9b7c2908-ca85-4f3f-b595-d9e6b9eab5c1"
      }
    },
    "owner": "combined"
  }
}
